# Copy to .env.local (local dev) or add in Vercel → Project → Settings →
# Environment Variables. Never commit real values.
#
# Anything WITHOUT the NEXT_PUBLIC_ prefix stays on the server and is never
# sent to the browser. Only the NEXT_PUBLIC_ variables below are public, and
# none of them are secrets.

# --- AI providers (server only; at least one required) ----------------------
# Lessons fail over between whichever providers are set, so two or three keys
# means a lesson never stalls on one provider's rate limit.

# https://aistudio.google.com/apikey  (free tier; the only provider that reads
# webcam frames and serves embeddings for document search, so set this first)
GEMINI_API_KEY=

# https://console.groq.com/keys  (free tier)
GROQ_API_KEY=

# https://dashboard.cohere.com/api-keys  (free trial tier)
COHERE_API_KEY=

# --- Storage: rate limiting and usage metrics (server only, optional) -------
# Free database at https://console.upstash.com/redis. Without these, rate
# limits and /metrics numbers live in memory and reset on every cold start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Owner dashboard (server only, optional) --------------------------------
# Password for /metrics. Open it as /metrics?key=<value>. Without it, /metrics
# is open on localhost and closed in production.
METRICS_TOKEN=

# --- Public settings (sent to the browser; not secrets) ---------------------
# Canonical URL for SEO and social previews. On Vercel this defaults to the
# production domain, so you rarely need it.
NEXT_PUBLIC_SITE_URL=

# Where the footer's "Send feedback" link points. Defaults to this repo's
# GitHub issues page (only works if the repo is public).
NEXT_PUBLIC_FEEDBACK_URL=

# 1 = show creator-story starters and the sponsor card (personal builds only).
NEXT_PUBLIC_SHOWCASE_MODE=

# Optional overrides for where the webcam gesture models load from. Leave
# empty to use the defaults in lib/use-gesture-recognition.ts.
NEXT_PUBLIC_MEDIAPIPE_WASM_PATH=
NEXT_PUBLIC_MEDIAPIPE_GESTURE_MODEL=
NEXT_PUBLIC_MEDIAPIPE_FACE_MODEL=
